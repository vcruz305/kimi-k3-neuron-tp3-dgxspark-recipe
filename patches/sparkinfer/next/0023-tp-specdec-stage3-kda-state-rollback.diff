+bool kimi_k3_dist_forward_rollback(KimiK3DistRank& rank, int j, std::string* error) {
+    if (!rank.loaded || !rank.stream) {
+        set_err(error, "dist_forward_rollback: rank not loaded");
+        return false;
+    }
+    if (rank.batch_n_tok < 1) {
+        set_err(error, "dist_forward_rollback: no batch to roll back");
+        return false;
+    }
+    if (j < 0 || j >= rank.batch_n_tok) {
+        set_err(error, "dist_forward_rollback: j " + std::to_string(j) +
+                           " outside [0," + std::to_string(rank.batch_n_tok - 1) + "]");
+        return false;
+    }
+    if (cudaSetDevice(rank.device) != cudaSuccess) {
+        set_err(error, "cudaSetDevice failed");
+        return false;
+    }
+
+    // ---- THE RECURRENT STATE ----
+    //
+    // TWO WAYS A j CAN BE SERVED, AND THE GAP BETWEEN THEM IS A SILENT-WRONG-ANSWER TRAP.
+    //
+    //   live     — j is the last token of the batch. Nothing was rejected, the state
+    //              already sits on that boundary, and there is nothing to copy.
+    //   snapshot — the ring holds the boundary after token j.
+    //
+    // These are mutually exclusive (the ring saves n_tok-1 slots, indices 0..n_tok-2) and
+    // together they are the whole legal range ONLY when the ring was on. With the ring off
+    // hist_saved is 0, and a real rejection matches neither arm: it must be REFUSED. The
+    // tempting shape here is "no snapshot, so do nothing and return true", which leaves
+    // the recurrent state holding every rejected draft and emits fluent, wrong text with
+    // no diagnostic anywhere.
+    const bool live_boundary = (j == rank.batch_n_tok - 1);
+    const bool have_snapshot = (j < rank.state.hist_saved);
+    if (!live_boundary && !have_snapshot) {
+        set_err(error, "dist_forward_rollback: no snapshot for j " + std::to_string(j) +
+                           " of " + std::to_string(rank.batch_n_tok) + " (ring saved " +
+                           std::to_string(rank.state.hist_saved) +
+                           "; was kimi_k3_dist_set_rollback called before the batch?)");
+        return false;
+    }
+    if (have_snapshot && !kimi_k3_state_rollback(rank.state, j, rank.stream)) {
+        set_err(error, "kimi_k3_state_rollback failed at j " + std::to_string(j));
+        return false;
+    }
