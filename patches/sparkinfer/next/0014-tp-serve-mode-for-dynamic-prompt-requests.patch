-                    prompts.size(), n_predict, max_ctx);
-        std::fflush(stdout);
-
         std::vector<float> logits((size_t)dist.cfg.vocab);
 
         auto one_step = [&](int tok, float* logits_out) -> bool {
@@ -364,6 +558,137 @@ int main(int argc, char** argv) {
             return true;
         };
 
+        // Serve mode: accept dynamic requests on a local control port instead of a
+        // fixed --prompts-file list, after the model is already resident. Reuses
+        // the exact same one_step()/KV-reset machinery as multi-prompt mode above --
+        // only the source of prompts changes (a socket loop instead of a static file).
+        if (!serve_addr.empty()) {
+            gen_trace("rank0 entering serve mode");
+            ServeListener slistener;
+            if (!slistener.listen(serve_host, serve_port, &err)) {
+                std::fprintf(stderr, "serve listen failed: %s\n", err.c_str());
+                return 1;
+            }
+            std::printf("[rank0] serve mode listening on %s:%u (world=%d, max_ctx=%d)\n",
+                        serve_host.c_str(), (unsigned)slistener.port(), world, max_ctx);
+            std::fflush(stdout);
+
+            using clock = std::chrono::steady_clock;
+            bool served_any = false;
+            for (;;) {
+                ServeConn conn;
+                std::string accept_err;
+                if (!slistener.accept(&conn, &accept_err)) {
+                    std::fprintf(stderr, "[rank0] serve accept failed: %s\n", accept_err.c_str());
+                    continue;
+                }
+                std::string line;
+                if (!conn.read_line(&line)) continue;  // client disconnected, no request
+
+                ServeRequest req;
+                std::string perr;
+                if (!parse_serve_request(line, &req, &perr)) {
+                    conn.write_line(format_serve_err(perr));
+                    continue;
+                }
+                if (req.shutdown) {
+                    conn.write_line("ok=1;shutdown=1");
+                    break;
+                }
+                if (req.prompt_ids.empty()) {
+                    conn.write_line(format_serve_err("empty prompt_ids"));
+                    continue;
+                }
+
+                if (served_any) {
+                    if (!one_step(kKvResetSentinel, nullptr)) {
+                        conn.write_line(format_serve_err("kv reset failed"));
+                        return 1;
+                    }
+                }
+                served_any = true;
+
+                bool step_ok = true;
+                const auto t_prefill0 = clock::now();
+                for (size_t i = 0; i < req.prompt_ids.size() && step_ok; ++i) {
+                    float* lp = (i + 1 == req.prompt_ids.size()) ? logits.data() : nullptr;
+                    step_ok = one_step(req.prompt_ids[i], lp);
+                }
+                if (!step_ok) {
+                    conn.write_line(format_serve_err("prefill failed"));
+                    return 1;
+                }
+                const double prefill_s = std::chrono::duration<double>(clock::now() - t_prefill0).count();
+
+                std::vector<int> generated;
+                std::string stop_reason = "length";
+                bool client_gone = false;
+                const auto t_gen0 = clock::now();
+                for (int n = 0; n < req.n_predict; ++n) {
+                    const int next = kimi_k3_dist_argmax(logits.data(), dist.cfg.vocab);
+                    if (req.stop_ids.count(next)) {
+                        stop_reason = "stop";
+                        break;
+                    }
+                    generated.push_back(next);
+                    // Streaming: push each token id as it is sampled, so the API
+                    // wrapper can forward it before the whole reply is done. "tok="
+                    // progress lines precede the single terminating "ok=..."/
+                    // "ok=0;..." line. A dead client (write failure) does not abort
+                    // decode -- the engine keeps running to completion so rank state
+                    // stays synchronized for the next request; we just stop trying
+                    // to write to a socket nobody is reading from any more.
+                    if (req.stream && !client_gone) {
+                        client_gone = !conn.write_line("tok=" + std::to_string(next));
+                    }
+                    if (!one_step(next, logits.data())) {
+                        if (!client_gone) conn.write_line(format_serve_err("decode failed"));
+                        return 1;
+                    }
+                }
+                const double decode_s = std::chrono::duration<double>(clock::now() - t_gen0).count();
+                std::fprintf(stderr,
+                             "[k3-dist][serve] prompt_tokens=%zu generated_tokens=%zu "
+                             "prefill_s=%.6f decode_s=%.6f stop_reason=%s\n",
+                             req.prompt_ids.size(), generated.size(), prefill_s, decode_s,
+                             stop_reason.c_str());
+                std::fflush(stderr);
+
+                conn.write_line(format_serve_ok(generated, prefill_s, decode_s, stop_reason));
+            }
+
+            gen_trace("rank0 serve mode finish enter");
+            if (!ctr.finish(&err)) {
+                std::fprintf(stderr, "finish: %s\n", err.c_str());
+                std::fflush(stderr);
+                return 1;
+            }
+            gen_trace("rank0 serve mode finish ok");
+            std::printf("OK finished clean (serve mode)\n");
+            std::fflush(stdout);
+            kimi_k3_dist_rank_free(&dist);
+            return 0;
+        }
+
+        // Build prompt list: multi-prompt file OR single prompt.
+        std::vector<std::vector<int>> prompts;
+        if (!prompts_file.empty()) {
+            prompts = load_prompts_file(prompts_file);
+        } else {
+            std::vector<int> prompt;
+            if (!prompt_file.empty()) prompt = load_ids_file(prompt_file);
+            else if (!prompt_csv.empty()) prompt = parse_ids_csv(prompt_csv);
+            else prompt = {1};
+            if (!prompt.empty()) prompts.push_back(std::move(prompt));
+        }
+        if (prompts.empty()) {
+            std::fprintf(stderr, "empty prompt ids\n");
+            return 2;
+        }
+        std::printf("[rank0] prompts=%zu n_predict=%d max_ctx=%d (multi-prompt keeps weights loaded)\n",
+                    prompts.size(), n_predict, max_ctx);
+        std::fflush(stdout);
+
         using clock = std::chrono::steady_clock;
         double sum_decode_tps = 0.0;
         int n_ok = 0;
