@@ -106,6 +123,189 @@ std::vector<std::vector<int>> load_prompts_file(const std::string& path) {
 // Special token: rank0 broadcasts this between multi-prompts; all ranks reset KV.
 constexpr int kKvResetSentinel = -2;
 
+// ---- Serve mode: a small local control port for dynamic requests ----------
+//
+// Deliberately not the rank_protocol::Message wire format (that framing carries
+// cluster-identity fields meant for inter-rank NCCL bootstrap, not a request from
+// a local client process). One connection at a time, one line in, one line out --
+// this only ever has a single caller (the API wrapper) and the engine itself is
+// strictly sequential (one KV cache, no batching), so nothing is gained by more.
+
+struct ServeRequest {
+    std::vector<int> prompt_ids;
+    int n_predict = 128;
+    std::set<int> stop_ids;
+    bool stream = false;
+    bool shutdown = false;
+};
+
+bool parse_serve_request(const std::string& line, ServeRequest* req, std::string* error) {
+    std::stringstream ss(line);
+    std::string field;
+    while (std::getline(ss, field, ';')) {
+        if (field.empty()) continue;
+        const auto eq = field.find('=');
+        if (eq == std::string::npos) {
+            if (error) *error = "malformed field (no '='): " + field;
+            return false;
+        }
+        const std::string key = field.substr(0, eq);
+        const std::string val = field.substr(eq + 1);
+        if (key == "prompt_ids") {
+            req->prompt_ids = parse_ids_csv(val);
+        } else if (key == "n_predict") {
+            req->n_predict = std::atoi(val.c_str());
+        } else if (key == "stop_ids") {
+            for (int id : parse_ids_csv(val)) req->stop_ids.insert(id);
+        } else if (key == "stream") {
+            req->stream = (val == "1");
+        } else if (key == "shutdown") {
+            req->shutdown = (val == "1");
+        }
+        // unknown keys ignored for forward-compat.
+    }
+    if (!req->shutdown && req->n_predict < 0) {
+        if (error) *error = "n_predict must be >= 0";
+        return false;
+    }
+    return true;
+}
+
+std::string format_serve_ok(const std::vector<int>& generated, double prefill_s,
+                            double decode_s, const std::string& stop_reason) {
+    std::ostringstream os;
+    os << "ok=1;generated_ids=";
+    for (size_t i = 0; i < generated.size(); ++i) os << (i ? "," : "") << generated[i];
+    os << ";prefill_s=" << prefill_s << ";decode_s=" << decode_s
+       << ";stop_reason=" << stop_reason;
+    return os.str();
+}
+
+std::string format_serve_err(const std::string& detail) {
+    std::string safe = detail;
+    for (char& c : safe) {
+        if (c == '\n' || c == '\r' || c == ';') c = ' ';
+    }
+    return "ok=0;error=" + safe;
+}
+
+// One accepted client connection on the serve control port.
+class ServeConn {
+public:
+    ServeConn() = default;
+    explicit ServeConn(int fd) : fd_(fd) {}
+    ~ServeConn() { close(); }
+    ServeConn(ServeConn&& other) noexcept : fd_(other.fd_) { other.fd_ = -1; }
+    ServeConn& operator=(ServeConn&& other) noexcept {
+        if (this != &other) {
+            close();
+            fd_ = other.fd_;
+            other.fd_ = -1;
+        }
+        return *this;
+    }
+    ServeConn(const ServeConn&) = delete;
+    ServeConn& operator=(const ServeConn&) = delete;
+
+    void close() {
+        if (fd_ >= 0) ::close(fd_);
+        fd_ = -1;
+    }
+
+    // Reads one '\n'-terminated line (bare LF or CRLF). Returns false only if no
+    // data was read at all before the peer closed (empty request).
+    bool read_line(std::string* out) {
+        out->clear();
+        char c;
+        for (;;) {
+            const ssize_t r = ::recv(fd_, &c, 1, 0);
+            if (r <= 0) return !out->empty();
+            if (c == '\n') return true;
+            if (c != '\r') out->push_back(c);
+            if (out->size() > (1u << 20)) return false;  // guard: no unbounded lines
+        }
+    }
+
+    bool write_line(const std::string& s) {
+        const std::string line = s + "\n";
+        std::size_t off = 0;
+        while (off < line.size()) {
+            const ssize_t w = ::send(fd_, line.data() + off, line.size() - off, 0);
+            if (w <= 0) return false;
+            off += static_cast<std::size_t>(w);
+        }
+        return true;
+    }
+
+private:
+    int fd_ = -1;
+};
+
+// Listen socket for the serve control port. IPv4 only, matches the rest of this
+// milestone's transport (see rank_transport_tcp.cpp TcpListener).
+class ServeListener {
+public:
+    ~ServeListener() { close(); }
+
+    bool listen(const std::string& host, uint16_t port, std::string* error) {
+        fd_ = ::socket(AF_INET, SOCK_STREAM, 0);
+        if (fd_ < 0) {
+            if (error) *error = "socket() failed";
+            return false;
+        }
+        int one = 1;
+        setsockopt(fd_, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+        sockaddr_in addr{};
+        addr.sin_family = AF_INET;
+        addr.sin_port = htons(port);
+        if (host.empty() || host == "0.0.0.0") {
+            addr.sin_addr.s_addr = htonl(INADDR_ANY);
+        } else if (::inet_pton(AF_INET, host.c_str(), &addr.sin_addr) != 1) {
+            if (error) *error = "invalid --serve host (IPv4 only)";
+            close();
+            return false;
+        }
+        if (::bind(fd_, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) != 0) {
+            if (error) *error = "bind() failed";
+            close();
+            return false;
+        }
+        if (::listen(fd_, 8) != 0) {
+            if (error) *error = "listen() failed";
+            close();
+            return false;
+        }
+        sockaddr_in bound{};
+        socklen_t blen = sizeof(bound);
+        if (getsockname(fd_, reinterpret_cast<sockaddr*>(&bound), &blen) == 0) {
+            port_ = ntohs(bound.sin_port);
+        }
+        return true;
+    }
+
+    uint16_t port() const { return port_; }
+
+    bool accept(ServeConn* out, std::string* error) {
+        sockaddr_in peer{};
+        socklen_t plen = sizeof(peer);
+        const int cfd = ::accept(fd_, reinterpret_cast<sockaddr*>(&peer), &plen);
+        if (cfd < 0) {
+            if (error) *error = "accept() failed";
+            return false;
+        }
+        *out = ServeConn(cfd);
+        return true;
+    }
+
+private:
+    void close() {
+        if (fd_ >= 0) ::close(fd_);
+        fd_ = -1;
+    }
+    int fd_ = -1;
+    uint16_t port_ = 0;
+};
+
 void fill_digests(RankSpec* spec) {
