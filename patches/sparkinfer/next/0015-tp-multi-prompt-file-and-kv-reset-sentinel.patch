+// Multi-prompt file: one prompt per non-empty, non-# line.
+// Each line is comma-separated token ids (spaces allowed).
+// Example:
+//   1,2,3
+//   10, 20, 30
+std::vector<std::vector<int>> load_prompts_file(const std::string& path) {
+    std::ifstream in(path);
+    std::vector<std::vector<int>> prompts;
+    std::string line;
+    while (std::getline(in, line)) {
+        // trim
+        while (!line.empty() && (line.back() == '\r' || line.back() == ' ' || line.back() == '\t'))
+            line.pop_back();
+        size_t a = 0;
+        while (a < line.size() && (line[a] == ' ' || line[a] == '\t')) ++a;
+        if (a >= line.size() || line[a] == '#') continue;
+        auto ids = parse_ids_csv(line.substr(a));
+        if (!ids.empty()) prompts.push_back(std::move(ids));
+    }
+    return prompts;
+}
