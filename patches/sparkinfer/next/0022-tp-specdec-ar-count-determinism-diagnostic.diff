+// DIAGNOSTIC PIN, OFF BY DEFAULT (SPARKINFER_K3_AR_PAD, 0 = off).
+//
+// ncclAllReduce is deterministic for a FIXED count/communicator/topology, but its
+// per-element cross-rank summation order is a function of the COUNT: the reduce-scatter
+// step partitions the buffer, the owning rank is where that element's 3-way sum starts,
+// and which rank owns a given element moves when the count moves. A K-token batch
+// reduces width*K, so token 0's elements sit in a different partition for every K --
+// re-associating (a+b)+c into (b+c)+a for some of them, 185 times per pass, with no
+// change to token 0's own data.
+//
+// Setting this to N pins every reduce to width*N rows regardless of K, so the partition
+// (and therefore token 0's summation order) is K-invariant. Rows past the live ones are
+// zeroed so the padding reduces to a defined value nothing reads. Capped at the scratch
+// cap, which is what sizes the buffers being reduced.
+int k3_ar_pad() {
+    static const int v = [] {
+        const char* e = std::getenv("SPARKINFER_K3_AR_PAD");
+        const int n = e ? std::atoi(e) : 0;
+        return n < 0 ? 0 : n;
+    }();
+    return v;
+}
+
+// Rows to reduce for a payload of `live` rows: `live` normally, the pin when it is set
+// and larger. Zeroes the padding rows it is about to add.
+int k3_ar_rows(KimiK3Forward& fwd, float* buf, int width, int live, cudaStream_t stream) {
+    const int pad = k3_ar_pad();
+    if (pad <= live) return live;
+    const int cap = kimi_k3_ffn_batch_cap(fwd);
+    const int rows = pad > cap ? cap : pad;
+    if (rows <= live) return live;
+    cudaMemsetAsync(buf + (std::size_t)width * (std::size_t)live, 0,
+                    (std::size_t)width * (std::size_t)(rows - live) * sizeof(float),
+                    stream);
+    return rows;
+}
+
