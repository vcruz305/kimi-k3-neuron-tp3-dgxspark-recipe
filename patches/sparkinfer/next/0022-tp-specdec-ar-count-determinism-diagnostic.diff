From cfdabb162bc6f73bac39af49a71624697d9ed5c7 Mon Sep 17 00:00:00 2001
From: Victor <victor@local>
Date: Tue, 11 Aug 2026 22:37:34 -0700
Subject: [PATCH] tp: 0022 all-reduce determinism diagnostics

---
 runtime/examples/kimi_k3_dist_generate.cpp  | 219 +++++++++++++++++---
 runtime/src/models/kimi_k3_dist_forward.cpp |  43 +++-
 2 files changed, 228 insertions(+), 34 deletions(-)

diff --git a/runtime/examples/kimi_k3_dist_generate.cpp b/runtime/examples/kimi_k3_dist_generate.cpp
index fa44f9b..bad7466 100644
--- a/runtime/examples/kimi_k3_dist_generate.cpp
+++ b/runtime/examples/kimi_k3_dist_generate.cpp
@@ -454,23 +454,124 @@ static int run_spec_bench(sparkinfer::KimiK3DistRank& dist,
         std::fflush(stdout);
     }
 
+    // ---- WHAT IS TOKEN 0 ALLOWED TO DEPEND ON? ----
+    //
+    // Token 0's logits move with K. Token 0 sits at the head of the batch and its correct
+    // value cannot causally depend on how many tokens follow it, so one of two things is
+    // true and they need opposite responses:
+    //
+    //   DATA  — some buffer lets tokens 1..K-1's VALUES reach token 0's computation.
+    //           Then holding K FIXED and changing only the filler tokens moves token 0.
+    //           That is a defect, and the same shape as the one this engine shipped once.
+    //   SHAPE — none of token 0's arithmetic changes, but the geometry does: grid
+    //           dimensions, kernel token-tiling, and above all the COLLECTIVE'S ELEMENT
+    //           COUNT, which is what decides NCCL's reduce-scatter partition and
+    //           therefore the order the three ranks' partials are summed in per element.
+    //           Then token 0 is BIT-IDENTICAL across fillers at fixed K, and moves only
+    //           when K moves.
+    //
+    // Compared BITWISE: under SHAPE an exact answer exists, and a tolerance would throw
+    // away the entire result. Token 0's row from the A run is kept so the K-to-K
+    // comparison is also exact rather than a cosine against the sequential arm.
+    std::vector<std::vector<float>> t0_of_K((size_t)Kmax + 1);
+    if (r0) {
+        std::printf("[spec-bench] --- token 0: data dependence vs shape dependence ---\n");
+        std::fflush(stdout);
+    }
+    for (int K = 2; K <= Kmax; ++K) {
+        std::vector<float> A(r0 ? (size_t)K * vocab : 0), B(r0 ? (size_t)K * vocab : 0);
+        std::vector<int> ia((size_t)K), ib((size_t)K);
+        for (int b = 0; b < K; ++b) ia[(size_t)b] = vtok(b);
+        // SAME token 0, deliberately far-apart fillers. Out-of-distribution ids route to
+        // different experts and drive different KDA state, which is the loudest
+        // perturbation available without changing the shape by one byte.
+        ib[0] = ia[0];
+        for (int b = 1; b < K; ++b) ib[(size_t)b] = 1000 + 37 * b;
+
+        if (!replay()) { std::fprintf(stderr, "replay failed: %s\n", err.c_str()); return 1; }
+        if (!sparkinfer::kimi_k3_dist_forward_batch(dist, coll, ia.data(), K,
+                                                    r0 ? A.data() : nullptr, &err)) {
+            std::fprintf(stderr, "filler-A batch failed: %s\n", err.c_str());
+            return 1;
+        }
+        if (!replay()) { std::fprintf(stderr, "replay failed: %s\n", err.c_str()); return 1; }
+        if (!sparkinfer::kimi_k3_dist_forward_batch(dist, coll, ib.data(), K,
+                                                    r0 ? B.data() : nullptr, &err)) {
+            std::fprintf(stderr, "filler-B batch failed: %s\n", err.c_str());
+            return 1;
+        }
+        if (!r0) continue;
+        t0_of_K[(size_t)K].assign(A.begin(), A.begin() + vocab);
+        const bool same =
+            std::memcmp(A.data(), B.data(), (size_t)vocab * sizeof(float)) == 0;
+        double maxabs = 0;
+        for (int i = 0; i < vocab; ++i) {
+            const double d = std::fabs((double)A[(size_t)i] - (double)B[(size_t)i]);
+            if (d > maxabs) maxabs = d;
+        }
+        std::printf("[spec-bench] K=%d token0 fillerA vs fillerB: %s  max|d|=%.3e\n", K,
+                    same ? "BIT-IDENTICAL (shape-only)" : "**DIFFERS (data reaches token 0)**",
+                    maxabs);
+        std::fflush(stdout);
+    }
+    if (r0 && Kmax >= 3) {
+        for (int K = 3; K <= Kmax; ++K) {
+            const bool same =
+                std::memcmp(t0_of_K[2].data(), t0_of_K[(size_t)K].data(),
+                            (size_t)vocab * sizeof(float)) == 0;
+            double maxabs = 0;
+            for (int i = 0; i < vocab; ++i) {
+                const double d = std::fabs((double)t0_of_K[2][(size_t)i] -
+                                           (double)t0_of_K[(size_t)K][(size_t)i]);
+                if (d > maxabs) maxabs = d;
+            }
+            std::printf("[spec-bench] token0 K=2 vs K=%d: %s  max|d|=%.3e\n", K,
+                        same ? "BIT-IDENTICAL" : "**DIFFERS**", maxabs);
+        }
+        std::fflush(stdout);
+    }
+
     if (r0) {
         std::printf("[spec-bench] --- timing: step(K) ---\n");
         std::fflush(stdout);
     }
-    // Steady-state only: the first pass after a reset pays cold caches and, on rank 0,
-    // the one-off logits reallocation. Every rank runs the same counts so the
-    // collectives stay matched.
-    const int warm = 2, reps = 5;
-    std::vector<double> ms_of_K((size_t)Kmax + 1, 0.0);
-    for (int K = 1; K <= Kmax; ++K) {
+    // ---- MEASURED SO THE SLOPE MEANS SOMETHING ----
+    //
+    // The first version of this ran all reps of K=1, then all of K=2, and so on, and
+    // averaged 5 samples. Two things were wrong with that and both push straight on m:
+    //
+    //   CONFOUND, and this is the important one. K advanced monotonically with
+    //   wall-clock time, so ANY slow drift across the timing phase -- clocks, thermals,
+    //   fabric contention -- lands in the SLOPE instead of the noise, because K was
+    //   perfectly correlated with time. That is the standard way to measure a trend
+    //   that is not there, and it is the likeliest reason K=3 came out slower than K=4
+    //   in two independent runs. Fixed by SWEEPING: one sample of every K per sweep,
+    //   with the starting K ROTATED per sweep so no K keeps a favoured slot. The
+    //   rotation is by sweep index and not random, because every rank has to issue the
+    //   identical call sequence or the collectives will not match.
+    //
+    //   MEAN OF FIVE. One straggler on any of three ranks, across 185 collectives, drags
+    //   a 5-sample mean a long way. Reported as a MEDIAN with the spread beside it, so
+    //   the reader can see whether the fit has earned any belief.
+    //
+    // State is re-anchored once per sweep, so every K within a sweep is measured at
+    // essentially the same context depth. It cannot be anchored once for the whole
+    // phase: the pass itself advances position by K.
+    const int warm_sweeps = 3;
+    int sweeps = 21;
+    if (const char* e = std::getenv("SPARKINFER_K3_SPEC_SWEEPS")) {
+        const int v = std::atoi(e);
+        if (v > 0) sweeps = v;
+    }
+    std::vector<std::vector<double>> samp((size_t)Kmax + 1);
+    std::vector<int> tids((size_t)Kmax);
+    for (int s = 0; s < warm_sweeps + sweeps; ++s) {
         if (!replay()) { std::fprintf(stderr, "replay failed: %s\n", err.c_str()); return 1; }
-        std::vector<int> ids((size_t)K);
-        double best_sum = 0;
-        for (int r = 0; r < warm + reps; ++r) {
-            for (int b = 0; b < K; ++b) ids[(size_t)b] = vtok(r * K + b);
+        for (int j = 0; j < Kmax; ++j) {
+            const int K = 1 + ((s + j) % Kmax);
+            for (int b = 0; b < K; ++b) tids[(size_t)b] = vtok(s * Kmax + j + b);
             const auto t0 = clock::now();
-            if (!sparkinfer::kimi_k3_dist_forward_batch(dist, coll, ids.data(), K,
+            if (!sparkinfer::kimi_k3_dist_forward_batch(dist, coll, tids.data(), K,
                                                         nullptr, &err)) {
                 std::fprintf(stderr, "timed batch failed: %s\n", err.c_str());
                 return 1;
@@ -478,32 +579,86 @@ static int run_spec_bench(sparkinfer::KimiK3DistRank& dist,
             if (cudaStreamSynchronize(dist.stream) != cudaSuccess) return 1;
             const double ms =
                 std::chrono::duration<double, std::milli>(clock::now() - t0).count();
-            if (r >= warm) best_sum += ms;
-        }
-        ms_of_K[(size_t)K] = best_sum / reps;
-        if (r0) {
-            std::printf("[spec-bench] step(K=%d) = %.3f ms   (%.3f ms/token)\n", K,
-                        ms_of_K[(size_t)K], ms_of_K[(size_t)K] / K);
-            std::fflush(stdout);
+            if (s >= warm_sweeps) samp[(size_t)K].push_back(ms);
         }
     }
-
-    if (r0 && Kmax >= 2) {
-        // Least-squares fit of step(K) = T + m*K over K = 1..Kmax. T is the fixed cost
-        // of a pass and m is what one extra verified position costs -- the number the
-        // whole speculative-decoding case rests on, and the one thing in the design
-        // that was modelled rather than measured.
-        double sx = 0, sy = 0, sxx = 0, sxy = 0;
+    if (!r0) return 0;
+
+    auto pct = [](std::vector<double> v, double q) {
+        if (v.empty()) return 0.0;
+        std::sort(v.begin(), v.end());
+        const double idx = q * (double)(v.size() - 1);
+        const size_t lo = (size_t)idx;
+        const size_t hi = lo + 1 < v.size() ? lo + 1 : lo;
+        return v[lo] + (idx - (double)lo) * (v[hi] - v[lo]);
+    };
+    std::vector<double> med((size_t)Kmax + 1, 0.0);
+    std::printf("[spec-bench] %d sweeps x %d K values, rotated order, %d warm sweeps "
+                "discarded\n", sweeps, Kmax, warm_sweeps);
+    std::printf("[spec-bench]  K   median     p25      p75      min     mean      sd    n\n");
+    for (int K = 1; K <= Kmax; ++K) {
+        const std::vector<double>& v = samp[(size_t)K];
+        double mean = 0;
+        for (double x : v) mean += x;
+        mean /= (double)v.size();
+        double sd = 0;
+        for (double x : v) sd += (x - mean) * (x - mean);
+        sd = v.size() > 1 ? std::sqrt(sd / (double)(v.size() - 1)) : 0.0;
+        med[(size_t)K] = pct(v, 0.5);
+        std::printf("[spec-bench] %2d %8.2f %8.2f %8.2f %8.2f %8.2f %7.2f %4zu\n", K,
+                    med[(size_t)K], pct(v, 0.25), pct(v, 0.75), pct(v, 0.0), mean, sd,
+                    v.size());
+    }
+    int inversions = 0;
+    for (int K = 2; K <= Kmax; ++K)
+        if (med[(size_t)K] < med[(size_t)K - 1]) ++inversions;
+    std::printf("[spec-bench] monotonicity: %d inversion(s) in median step(K) "
+                "(0 = clean)\n", inversions);
+
+    if (Kmax >= 3) {
+        // OLS on the MEDIANS, with the uncertainty it deserves. se(m) is the standard
+        // error of the slope; the CI uses Student t at n-2 dof, which matters at these
+        // tiny n (t = 3.18 at dof 3, not 1.96).
         const int n = Kmax;
+        double sx = 0, sy = 0, sxx = 0, sxy = 0;
+        for (int K = 1; K <= Kmax; ++K) {
+            sx += K; sy += med[(size_t)K];
+            sxx += (double)K * K; sxy += (double)K * med[(size_t)K];
+        }
+        const double m = ((double)n * sxy - sx * sy) / ((double)n * sxx - sx * sx);
+        const double T = (sy - m * sx) / (double)n;
+        double ss_res = 0, ss_tot = 0;
+        const double ybar = sy / (double)n;
         for (int K = 1; K <= Kmax; ++K) {
-            sx += K; sy += ms_of_K[(size_t)K];
-            sxx += (double)K * K; sxy += (double)K * ms_of_K[(size_t)K];
+            const double r = med[(size_t)K] - (T + m * (double)K);
+            ss_res += r * r;
+            ss_tot += (med[(size_t)K] - ybar) * (med[(size_t)K] - ybar);
         }
-        const double m = (n * sxy - sx * sy) / (n * sxx - sx * sx);
-        const double T = (sy - m * sx) / n;
-        std::printf("\n[spec-bench] FIT step(K) = %.2f + %.2f*K ms\n", T, m);
-        std::printf("[spec-bench] marginal cost m = %.2f ms; break-even acceptance "
-                    "m/step(1) = %.4f\n", m, m / ms_of_K[1]);
+        const double sxx_c = sxx - sx * sx / (double)n;
+        const double se_m =
+            n > 2 && sxx_c > 0 ? std::sqrt((ss_res / (double)(n - 2)) / sxx_c) : 0.0;
+        const double r2 = ss_tot > 0 ? 1.0 - ss_res / ss_tot : 0.0;
+        static const double tcrit[11] = {0, 12.71, 4.30, 3.18, 2.78, 2.57,
+                                         2.45, 2.36, 2.31, 2.26, 2.23};
+        const int dof = n - 2;
+        const double tc = dof >= 1 && dof <= 10 ? tcrit[dof] : 1.96;
+
+        // Theil-Sen: median of all pairwise slopes. Immune to any single bad K, so if it
+        // disagrees with OLS the OLS is being led by one point.
+        std::vector<double> slopes;
+        for (int i = 1; i <= Kmax; ++i)
+            for (int j = i + 1; j <= Kmax; ++j)
+                slopes.push_back((med[(size_t)j] - med[(size_t)i]) / (double)(j - i));
+        const double ts = pct(slopes, 0.5);
+
+        std::printf("\n[spec-bench] FIT step(K) = %.2f + %.2f*K ms   (OLS on medians)\n",
+                    T, m);
+        std::printf("[spec-bench] m = %.2f ms  se = %.2f  95%% CI [%.2f, %.2f]  "
+                    "R2 = %.4f  dof = %d\n", m, se_m, m - tc * se_m, m + tc * se_m, r2,
+                    dof);
+        std::printf("[spec-bench] Theil-Sen slope = %.2f ms (robust cross-check)\n", ts);
+        std::printf("[spec-bench] break-even acceptance m/step(1) = %.4f\n",
+                    m / med[1]);
         std::fflush(stdout);
     }
     return 0;
diff --git a/runtime/src/models/kimi_k3_dist_forward.cpp b/runtime/src/models/kimi_k3_dist_forward.cpp
index ed96242..b9b643f 100755
--- a/runtime/src/models/kimi_k3_dist_forward.cpp
+++ b/runtime/src/models/kimi_k3_dist_forward.cpp
@@ -80,6 +80,43 @@ bool ensure_logits(KimiK3DistRank& rank) {
     return true;
 }
 
+// DIAGNOSTIC PIN, OFF BY DEFAULT (SPARKINFER_K3_AR_PAD, 0 = off).
+//
+// ncclAllReduce is deterministic for a FIXED count/communicator/topology, but its
+// per-element cross-rank summation order is a function of the COUNT: the reduce-scatter
+// step partitions the buffer, the owning rank is where that element's 3-way sum starts,
+// and which rank owns a given element moves when the count moves. A K-token batch
+// reduces width*K, so token 0's elements sit in a different partition for every K --
+// re-associating (a+b)+c into (b+c)+a for some of them, 185 times per pass, with no
+// change to token 0's own data.
+//
+// Setting this to N pins every reduce to width*N rows regardless of K, so the partition
+// (and therefore token 0's summation order) is K-invariant. Rows past the live ones are
+// zeroed so the padding reduces to a defined value nothing reads. Capped at the scratch
+// cap, which is what sizes the buffers being reduced.
+int k3_ar_pad() {
+    static const int v = [] {
+        const char* e = std::getenv("SPARKINFER_K3_AR_PAD");
+        const int n = e ? std::atoi(e) : 0;
+        return n < 0 ? 0 : n;
+    }();
+    return v;
+}
+
+// Rows to reduce for a payload of `live` rows: `live` normally, the pin when it is set
+// and larger. Zeroes the padding rows it is about to add.
+int k3_ar_rows(KimiK3Forward& fwd, float* buf, int width, int live, cudaStream_t stream) {
+    const int pad = k3_ar_pad();
+    if (pad <= live) return live;
+    const int cap = kimi_k3_ffn_batch_cap(fwd);
+    const int rows = pad > cap ? cap : pad;
+    if (rows <= live) return live;
+    cudaMemsetAsync(buf + (std::size_t)width * (std::size_t)live, 0,
+                    (std::size_t)width * (std::size_t)(rows - live) * sizeof(float),
+                    stream);
+    return rows;
+}
+
 bool allreduce_partial(KimiK3Forward& fwd, int layer, K3LayerPhase phase,
                        tp::dist::RankCollective& coll, cudaStream_t stream,
                        std::string* error) {
@@ -89,7 +126,8 @@ bool allreduce_partial(KimiK3Forward& fwd, int layer, K3LayerPhase phase,
         set_err(error, "partial buffer missing for allreduce");
         return false;
     }
-    if (!coll.allreduce_f32(buf, (std::size_t)n,
+    const std::size_t count = (std::size_t)n * (std::size_t)k3_ar_rows(fwd, buf, n, 1, stream);
+    if (!coll.allreduce_f32(buf, count,
                             (tp::dist::RankStreamHandle)(std::uintptr_t)stream)) {
         set_err(error, "RankCollective::allreduce_f32 failed");
         return false;
@@ -577,7 +615,8 @@ bool allreduce_partial_batch(KimiK3Forward& fwd, int layer, K3LayerPhase phase,
         set_err(error, "partial buffer missing for batched allreduce");
         return false;
     }
-    const std::size_t count = (std::size_t)width * (std::size_t)n_tok;
+    const std::size_t count =
+        (std::size_t)width * (std::size_t)k3_ar_rows(fwd, buf, width, n_tok, stream);
     if (!coll.allreduce_f32(buf, count,
                             (tp::dist::RankStreamHandle)(std::uintptr_t)stream)) {
         set_err(error, "RankCollective::allreduce_f32 failed (batched)");
