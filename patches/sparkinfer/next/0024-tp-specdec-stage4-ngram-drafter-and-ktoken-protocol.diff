+bool Coordinator::begin_step_multi(const int* token_ids, int n_tok, int prev_rollback_j,
+                                   std::vector<Message>* outbound, std::string* error) {
+    if (state_ != CoordinatorState::Ready) {
+        if (state_ == CoordinatorState::Failed) { set_error(error, failure_); return false; }
+        if (state_ == CoordinatorState::Finished) {
+            set_error(error, "cluster already finished");
+            return false;
+        }
+        return abort_cluster(Phase::Step, -14, "batch started before cluster Ready",
+                             outbound, error);
+    }
+    if (!outbound) return abort_cluster(Phase::Step, -15,
+                                        "batch broadcast has no outbound sink", outbound, error);
+    if (!token_ids || n_tok < 1 || n_tok > kMaxStepTokens)
+        return abort_cluster(Phase::Step, -23, "batch token count outside protocol bounds",
+                             outbound, error);
+    // No -2 sentinel here: a KV reset is a whole-step operation, not a batch member.
+    for (int b = 0; b < n_tok; ++b)
+        if (token_ids[b] < 0 || token_ids[b] >= cluster_.vocab)
+            return abort_cluster(Phase::Step, -16, "batch token id outside vocabulary",
+                                 outbound, error);
+    if (prev_rollback_j < -1 || prev_rollback_j >= kMaxStepTokens)
+        return abort_cluster(Phase::Step, -24, "rollback index outside protocol bounds",
+                             outbound, error);
+    std::fill(step_done_.begin(), step_done_.end(), 0);
+    for (int rank = 0; rank < cluster_.world_size; ++rank) {
+        Message m = control(MessageType::Token, rank);
+        m.phase = Phase::Step;
+        m.token_id = token_ids[0];
+        m.rollback_j = prev_rollback_j;
+        m.token_ids.assign(token_ids, token_ids + n_tok);
+        outbound->push_back(std::move(m));
+    }
+    state_ = CoordinatorState::StepInFlight;
+    return true;
+}
