new file mode 100644
--- /dev/null
+++ b/runtime/include/sparkinfer/models/kimi_k3_ngram_draft.h
@@ -0,0 +1,91 @@
+#pragma once
+// Prompt-lookup (n-gram self-speculation) drafter — pure host logic, no GPU, no NCCL.
+//
+// At each decode step the caller asks: given everything generated so far, what tokens
+// are likely to come next? This answers by finding where the current tail last occurred
+// earlier in the same sequence and proposing whatever followed it that time. It is the
+// whole drafting strategy for K3 speculative decoding, chosen because the model occupies
+// ~110 GB of each Spark's 121 GB and leaves no room for draft weights, and because a
+// drafter that costs nothing when it declines to draft is nearly free to attempt against
+// a break-even acceptance of ~0.13.
+//
+// Cost is a backward memcmp scan over a few thousand ints — microseconds, off the GPU and
+// off the critical path. Header-only so the decode loop and its test share one definition
+// rather than two that can drift.
+
+#include <cstddef>
+#include <cstring>
+#include <vector>
+
+namespace sparkinfer {
+
+struct K3NgramDraftConfig {
+    // Longest tail matched first. Longer matches are rarer but far likelier to continue
+    // correctly, so the scan is strictly best-first: the first n that hits wins.
+    int n_max = 3;
+    // Shortest tail the drafter will accept a match on. Measured on TP3, 3 workloads,
+    // 64 tokens each, against a two-run baseline: n_min = 1 fires on almost every step
+    // because some single token always recurs, and those matches are mostly junk — it
+    // cost freeform prose 12.5% (a K-wide pass bought ~1 token) while buying only 8% more
+    // on code than n_min = 2 does. n_min = 3 is too shy: it drafts on 16% of steps and
+    // gives back most of the win. 2 is the measured optimum, not a guess.
+    int n_min = 2;
+};
+
+// Propose up to max_draft continuation tokens for ctx, appending them to *out.
+// Returns the number proposed; 0 means "no match, take the ordinary single-token path".
+//
+// ctx must be the FULL token history the model has consumed plus the one token the
+// caller is about to feed — the drafter predicts what follows that token, so leaving it
+// out shifts every proposal one position early.
+inline int kimi_k3_ngram_draft(const std::vector<int>& ctx, int max_draft,
+                               const K3NgramDraftConfig& cfg, std::vector<int>* out) {
+    if (!out || max_draft <= 0 || ctx.empty()) return 0;
+    const long long len = (long long)ctx.size();
+    const int n_hi = cfg.n_max < (int)len ? cfg.n_max : (int)len;
+    const int n_lo = cfg.n_min < 1 ? 1 : cfg.n_min;
+
+    for (int n = n_hi; n >= n_lo; --n) {
+        const int* pat = ctx.data() + (len - n);
+        // Backward from the latest possible start, so the FIRST hit is the most recent
+        // occurrence. Recency matters: in structured output the nearest repetition is the
+        // one still in the model's active pattern, and an older one is likely a different
+        // block that merely shares a prefix. Start at len-n-1 so the tail cannot match
+        // itself and so at least one token follows the match.
+        for (long long s = len - n - 1; s >= 0; --s) {
+            if (std::memcmp(ctx.data() + s, pat, (std::size_t)n * sizeof(int)) != 0)
+                continue;
+            const long long from = s + n;
+            int d = 0;
+            for (long long t = from; t < len && d < max_draft; ++t, ++d)
+                out->push_back(ctx[(std::size_t)t]);
+            if (d > 0) return d;
+        }
+    }
+    return 0;
+}
+
+// Longest accepted prefix of a K-token verify pass, plus the bonus token.
+//
+// row_argmax(i) must return the argmax of verify-pass logits row i — the token that
+// truly follows batch position i. Draft i is accepted exactly when it equals that.
+// Called lazily and never past the first mismatch: each call scans a full 163840-wide
+// vocabulary row, and rows after a rejection describe a prefix that did not happen.
+//
+// Returns j, the number of accepted drafts, in [0, d]. *bonus receives the token
+// verified at row j; it came from a fully accepted prefix, so it is emitted whatever was
+// drafted — it is exactly the token a non-speculative step would have produced. The step
+// therefore emits j+1 tokens, and the state must be rolled back to index j.
+template <typename RowArgmax>
+inline int kimi_k3_spec_accept_prefix(const int* draft, int d, RowArgmax row_argmax,
+                                      int* bonus) {
+    int j = 0;
+    for (;;) {
+        const int a = row_argmax(j);
+        if (j < d && draft && a == draft[j]) { ++j; continue; }
+        if (bonus) *bonus = a;
+        return j;
+    }
+}
+
+}  // namespace sparkinfer
