+// Lazily size the batch scratch. Grows monotonically and never shrinks: a caller that
+// sweeps K = 1..8 to fit a cost model would otherwise reallocate on every step and
+// measure the allocator.
+bool ensure_batch(KimiK3DistRank& rank, int n_tok) {
+    if (rank.batch_cap >= n_tok) return true;
+    const KimiK3Config& cfg = rank.cfg;
+    const int H = cfg.hidden;
+
+    if (rank.xb)      { cudaFree(rank.xb);      rank.xb = nullptr; }
+    if (rank.xb_next) { cudaFree(rank.xb_next); rank.xb_next = nullptr; }
+    if (rank.pos_vec) { cudaFree(rank.pos_vec); rank.pos_vec = nullptr; }
+    if (rank.bank_b)  { cudaFree(rank.bank_b);  rank.bank_b = nullptr; }
+    rank.batch_cap = 0;
+
+    const size_t bank_elems = (size_t)rank.state.max_ckpt * (size_t)H;
+    if (cudaMalloc(&rank.xb, (size_t)n_tok * H * sizeof(float)) != cudaSuccess ||
+        cudaMalloc(&rank.xb_next, (size_t)n_tok * H * sizeof(float)) != cudaSuccess ||
+        cudaMalloc(&rank.pos_vec, (size_t)n_tok * sizeof(int)) != cudaSuccess)
+        return false;
+    if (bank_elems &&
+        cudaMalloc(&rank.bank_b, (size_t)n_tok * bank_elems * sizeof(float)) != cudaSuccess)
+        return false;
+
+    // Rank 0's logits grow to a full [n_tok, vocab] block. The single-token entry
+    // point writes row 0 of the same allocation, so the two can share it.
+    if (rank.plan.spec.rank == 0) {
+        if (rank.logits) { cudaFree(rank.logits); rank.logits = nullptr; }
+        if (cudaMalloc(&rank.logits,
+                       (size_t)n_tok * (size_t)cfg.vocab * sizeof(float)) != cudaSuccess)
+            return false;
+    }
+    rank.batch_cap = n_tok;
+    return true;
