+// ---------------------------------------------------------------------------
+// --spec-bench: batched-verify correctness + marginal-cost measurement
+// ---------------------------------------------------------------------------
+//
+// Runs IDENTICALLY ON EVERY RANK and sends no control messages. That is deliberate:
+// the rank protocol carries one token id per step, and widening it is Stage 4's work
+// (it belongs with the drafter that needs it). Here every rank derives the same verify
+// tokens from the same --prompt-ids it was already given, so the ranks stay in lockstep
+// through the NCCL collectives without a protocol change — which keeps this measurement
+// from depending on a message format nobody has reviewed yet.
+//
+// Two things are measured, and they answer different questions:
+//   1. Does forward_batch(K) agree with K sequential forward_token calls? Reported as
+//      cosine, top-1 agreement and exact-equality — NOT as a pass/fail. The engine has
+//      a known numerical-fidelity gap at longer context (near-tied MoE routing under
+//      IQ1_S), so "batched verify disagrees with sequential decode" is a plausible real
+//      outcome, and a bare assert would hide the size of it.
+//   2. What does an extra verified position cost? step(K) for K = 1..Kmax, from which
+//      the marginal cost m is fitted. Everything downstream of this stage depends on
+//      that number.
+static int run_spec_bench(sparkinfer::KimiK3DistRank& dist,
+                          sparkinfer::tp::dist::RankCollective& coll,
+                          const std::vector<int>& prompt, int Kmax) {
+    using clock = std::chrono::steady_clock;
+    const int rank_id = dist.plan.spec.rank;
+    const int vocab = dist.cfg.vocab;
+    const bool r0 = (rank_id == 0);
+    std::string err;
+
+    // The verify tokens are the prompt cycled: deterministic on every rank without a
+    // message, and in-distribution, so MoE routing (and therefore the expert traffic
+    // that dominates the marginal cost) stays representative.
+    auto vtok = [&](int i) { return prompt[(size_t)(i % (int)prompt.size())]; };
+
+    auto replay = [&]() -> bool {
+        sparkinfer::kimi_k3_reset_state(dist.state);
+        if (cudaStreamSynchronize(dist.stream) != cudaSuccess) return false;
+        for (size_t i = 0; i < prompt.size(); ++i)
+            if (!sparkinfer::kimi_k3_dist_forward_token(dist, coll, prompt[i], nullptr,
+                                                        &err))
+                return false;
+        return true;
+    };
+
+    if (r0) {
+        std::printf("\n[spec-bench] prompt=%zu tokens, Kmax=%d, vocab=%d\n",
+                    prompt.size(), Kmax, vocab);
+        std::printf("[spec-bench] --- correctness: forward_batch(K) vs K x forward_token ---\n");
+        std::fflush(stdout);
+    }
+
+    for (int K = 2; K <= Kmax; ++K) {
+        std::vector<float> seq(r0 ? (size_t)K * vocab : 0);
+        std::vector<float> bat(r0 ? (size_t)K * vocab : 0);
+        std::vector<int> ids((size_t)K);
+        for (int b = 0; b < K; ++b) ids[(size_t)b] = vtok(b);
+
+        if (!replay()) { std::fprintf(stderr, "replay failed: %s\n", err.c_str()); return 1; }
+        for (int b = 0; b < K; ++b)
+            if (!sparkinfer::kimi_k3_dist_forward_token(
+                    dist, coll, ids[(size_t)b],
+                    r0 ? seq.data() + (size_t)b * vocab : nullptr, &err)) {
+                std::fprintf(stderr, "seq forward failed: %s\n", err.c_str());
+                return 1;
+            }
+
+        if (!replay()) { std::fprintf(stderr, "replay failed: %s\n", err.c_str()); return 1; }
+        if (!sparkinfer::kimi_k3_dist_forward_batch(dist, coll, ids.data(), K,
+                                                    r0 ? bat.data() : nullptr, &err)) {
+            std::fprintf(stderr, "batch forward failed: %s\n", err.c_str());
+            return 1;
+        }
+
+        if (!r0) continue;
+        for (int b = 0; b < K; ++b) {
+            const float* a = seq.data() + (size_t)b * vocab;
+            const float* c = bat.data() + (size_t)b * vocab;
+            double dot = 0, na = 0, nc = 0, maxabs = 0;
+            size_t n_exact = 0;
+            int ta = 0, tc = 0;
+            for (int i = 0; i < vocab; ++i) {
+                dot += (double)a[i] * (double)c[i];
+                na += (double)a[i] * (double)a[i];
+                nc += (double)c[i] * (double)c[i];
+                const double d = std::fabs((double)a[i] - (double)c[i]);
+                if (d > maxabs) maxabs = d;
+                if (std::memcmp(&a[i], &c[i], sizeof(float)) == 0) ++n_exact;
+                if (a[i] > a[ta]) ta = i;
+                if (c[i] > c[tc]) tc = i;
+            }
+            const double cos = dot / (std::sqrt(na) * std::sqrt(nc) + 1e-30);
+            std::printf("[spec-bench] K=%d pos=%d cos=%.9f top1 seq=%d bat=%d %s "
+                        "max|d|=%.3e exact=%.4f%%\n",
+                        K, b, cos, ta, tc, ta == tc ? "AGREE" : "**DISAGREE**", maxabs,
+                        100.0 * (double)n_exact / (double)vocab);
+        }
+        std::fflush(stdout);
+    }
+
+    if (r0) {
+        std::printf("[spec-bench] --- timing: step(K) ---\n");
+        std::fflush(stdout);
+    }
+    // Steady-state only: the first pass after a reset pays cold caches and, on rank 0,
+    // the one-off logits reallocation. Every rank runs the same counts so the
+    // collectives stay matched.
+    const int warm = 2, reps = 5;
+    std::vector<double> ms_of_K((size_t)Kmax + 1, 0.0);
+    for (int K = 1; K <= Kmax; ++K) {
+        if (!replay()) { std::fprintf(stderr, "replay failed: %s\n", err.c_str()); return 1; }
+        std::vector<int> ids((size_t)K);
+        double best_sum = 0;
+        for (int r = 0; r < warm + reps; ++r) {
+            for (int b = 0; b < K; ++b) ids[(size_t)b] = vtok(r * K + b);
+            const auto t0 = clock::now();
+            if (!sparkinfer::kimi_k3_dist_forward_batch(dist, coll, ids.data(), K,
+                                                        nullptr, &err)) {
+                std::fprintf(stderr, "timed batch failed: %s\n", err.c_str());
+                return 1;
+            }
+            if (cudaStreamSynchronize(dist.stream) != cudaSuccess) return 1;
+            const double ms =
+                std::chrono::duration<double, std::milli>(clock::now() - t0).count();
+            if (r >= warm) best_sum += ms;
+        }
+        ms_of_K[(size_t)K] = best_sum / reps;
+        if (r0) {
+            std::printf("[spec-bench] step(K=%d) = %.3f ms   (%.3f ms/token)\n", K,
+                        ms_of_K[(size_t)K], ms_of_K[(size_t)K] / K);
+            std::fflush(stdout);
+        }
+    }
+
+    if (r0 && Kmax >= 2) {
+        // Least-squares fit of step(K) = T + m*K over K = 1..Kmax. T is the fixed cost
+        // of a pass and m is what one extra verified position costs -- the number the
+        // whole speculative-decoding case rests on, and the one thing in the design
+        // that was modelled rather than measured.
+        double sx = 0, sy = 0, sxx = 0, sxy = 0;
+        const int n = Kmax;
+        for (int K = 1; K <= Kmax; ++K) {
+            sx += K; sy += ms_of_K[(size_t)K];
+            sxx += (double)K * K; sxy += (double)K * ms_of_K[(size_t)K];
+        }
+        const double m = (n * sxy - sx * sy) / (n * sxx - sx * sx);
+        const double T = (sy - m * sx) / n;
+        std::printf("\n[spec-bench] FIT step(K) = %.2f + %.2f*K ms\n", T, m);
+        std::printf("[spec-bench] marginal cost m = %.2f ms; break-even acceptance "
+                    "m/step(1) = %.4f\n", m, m / ms_of_K[1]);
+        std::fflush(stdout);
+    }
+    return 0;
+}
