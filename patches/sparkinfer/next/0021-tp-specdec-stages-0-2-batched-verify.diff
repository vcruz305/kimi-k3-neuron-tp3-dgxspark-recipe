index 6a210c3..5b791ba 100644
--- a/runtime/include/sparkinfer/models/kimi_k3.h
+++ b/runtime/include/sparkinfer/models/kimi_k3.h
@@ -289,9 +289,38 @@ struct KimiK3RuntimeState {
 
     // Indexed by KDA-layer ordinal (0..n_kda_layers-1), NOT the global layer index —
     // see kda_layer_ordinal() below.
+    //
+    // THESE ARE OFFSETS INTO THE FOUR ARENAS BELOW, NOT INDEPENDENT ALLOCATIONS. Every
+    // reader keeps indexing them exactly as before; only where they point changed.
     std::vector<float*> conv_state_q, conv_state_k, conv_state_v;   // [d_conv-1, qkv]
     std::vector<float*> delta_state;                               // [head_dim, head_dim, n_head]
 
+    // ---- THE KDA STATE ARENAS: one contiguous allocation per buffer kind ----
+    //
+    // The recurrent state used to be 4 cudaMallocs per KDA layer — 276 separate
+    // allocations at 69 layers. Nothing about the forward cared, because it only ever
+    // touches one layer's slot at a time. What cares is anything that moves the WHOLE
+    // state at once: a snapshot/restore for speculative rollback is 276 memcpys against
+    // a ~1.7 us launch floor (~0.47 ms of pure overhead per save) when the slots are
