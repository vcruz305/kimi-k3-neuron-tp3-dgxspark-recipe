+// TOKEN-BATCHED F16 PROJECTION — the LM head's batched form, and the only reason it
+// is separate from the Q8_0 one above is that the head is the model's single F16
+// weight and that helper is Q8_0-only.
+//
+// [n_tok, K] activation (rows x_stride apart) -> [n_tok, N] output (rows ldy apart),
+// reading the 2.349 GB head ONCE for the whole batch instead of once per position.
+// Looping the single-token k3_proj_f32 instead costs ~16 ms per extra position at the
+// measured 146.8 GB/s, which roughly doubles the marginal cost of a speculative token.
+//
+// BIT-IDENTICAL per output element to n_tok separate k3_proj_f32 calls: same k-walk
+// (the same 8-way unrolled `k += 8*BLOCK` main loop and `k += BLOCK` tail from the
+// same starting threadIdx.x), same `acc += w[u]*v[u]` order, same block_sum tree.
+// n_tok only decides which outputs share a CUDA block.
+//
+// SPARKINFER_K3_HEAD_TOKS sets the token tile (2/4/8, default 8); =0 declines so the
+// caller falls back to the per-token loop on the same binary. Returns false meaning
+// "use the per-token path" for n_tok == 1, a non-F16 weight, or under-sized strides.
+bool k3_proj_f16_tok_f32(float* y, int ldy, const float* x, int64_t x_stride,
+                         const void* W, int wtype, int N, int K, int n_tok,
+                         cudaStream_t stream);
+
 bool k3_proj_ggml_f32(float* y, const float* x, const void* W, int wtype,
                       int N, int K, void* q8_scratch, cudaStream_t stream);
 
