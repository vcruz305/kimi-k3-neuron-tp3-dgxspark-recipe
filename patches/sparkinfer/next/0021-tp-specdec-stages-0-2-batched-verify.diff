     if (threadIdx.x == 0) y[n] = acc;
 }
 
+// TOKEN-BATCHED F16 PROJECTION — proj_f16_kernel with a token axis inside the block.
+//
+// WHY IT HAS TO EXIST. The LM head is the one F16 weight in the model and it is
+// 163840 x 7168 = 2.349 GB. A K-token verify pass that looped proj_f16_kernel would
+// re-stream all 2.349 GB per position; at the measured 146.8 GB/s that is ~16 ms of
+// pure weight traffic per extra token, which on its own roughly DOUBLES the marginal
+// cost of a speculative position and moves the break-even acceptance from 0.093 to
+// ~0.19. Every other big projection in the model already has a token-batched form
+// (k3_proj_q8act_tok_f32); that one is Q8_0-only and the head is not Q8_0.
+//
+// The row of W is loaded ONCE per k-chunk and spent on TOKS activations, so the
+// weight term divides by TOKS. What repeats instead is the activation, 28 KB against
+// 2.349 GB.
+//
+// BIT-IDENTICAL PER OUTPUT ELEMENT, and here is the whole argument. Fix an output
+// (t, n) and compare with proj_f16_kernel run on token t alone:
+//   * k-walk. Both start at k = threadIdx.x and stride the SAME way — the 8-way
+//     unrolled `k += 8*BLOCK` main loop with the same `k + 7*BLOCK < K` bound, then
+//     the same `k += BLOCK` tail. Thread i owns exactly the same k values in the same
+//     ascending order.
+//   * accumulation. Both do `acc += w[u] * v[u]` for u = 0..7 in ascending u, with w
+//     the same __half2float(row[...]) and v the same x[...]. Same expression, same
+//     associativity, same order.
+//   * reduction tree. Both call block_sum<BLOCK> over the same BLOCK threads, which
+//     does the same shfl_down butterfly and the same ascending fold over warps.
+// TOKS changes only which output elements share a CUDA block, and it appears in no
+// accumulation order. That is the same argument proj_q8_0_q8_0_tok_kernel already
+// leans on for the Q8_0 side.
+//
+// block_sum contains __syncthreads(), so EVERY thread calls it for EVERY t and only
+// the store is guarded — the same rule the multirow kernel above is written to. The
+// bounds check on the accumulate loops is a separate matter: those contain no
+// barrier, so skipping an out-of-range token there is ordinary divergence.
+template <int BLOCK, int TOKS>
+__global__ void proj_f16_tok_kernel(float* __restrict__ y, int ldy,
+                                    const float* __restrict__ x, int64_t x_stride,
+                                    const __half* __restrict__ W, int K, int n_tok) {
+    k3_pdl_sync();
+    const int n  = blockIdx.x;
+    const int t0 = blockIdx.y * TOKS;
+    const __half* row = W + (size_t)n * K;
+    __shared__ float shm[BLOCK / 32 + 1];
+    float acc[TOKS];
+#pragma unroll
+    for (int t = 0; t < TOKS; ++t) acc[t] = 0.0f;
+
+    int k = threadIdx.x;
+    for (; k + 7 * BLOCK < K; k += 8 * BLOCK) {
+        float w[8];
+#pragma unroll
+        for (int u = 0; u < 8; ++u) w[u] = __half2float(row[k + u * BLOCK]);
+#pragma unroll
+        for (int t = 0; t < TOKS; ++t) {
+            if (t0 + t >= n_tok) continue;
+            const float* xt = x + (int64_t)(t0 + t) * x_stride;
+            float v[8];
+#pragma unroll
+            for (int u = 0; u < 8; ++u) v[u] = xt[k + u * BLOCK];
+#pragma unroll
+            for (int u = 0; u < 8; ++u) acc[t] += w[u] * v[u];
+        }
+    }
+    for (; k < K; k += BLOCK) {
+        const float wv = __half2float(row[k]);
+#pragma unroll
+        for (int t = 0; t < TOKS; ++t) {
+            if (t0 + t >= n_tok) continue;
+            acc[t] += wv * x[(int64_t)(t0 + t) * x_stride + k];
+        }
+    }
+#pragma unroll
+    for (int t = 0; t < TOKS; ++t) {
+        const float s = block_sum<BLOCK>(acc[t], shm);
+        if (threadIdx.x == 0 && t0 + t < n_tok)
+            y[(size_t)(t0 + t) * (size_t)ldy + n] = s;
+    }
+}
+
 
 // ROW AXIS (blockIdx.y). ALL THREE operands are row-major activations and all three are
 // offset — this entry point is the residual combine, not a broadcast bias add. A caller
@@ -6365,6 +6443,64 @@ bool k3_proj_q8act_tok_f32(float* y, int ldy, const void* q8_act, int ld_act_blo
     return true;
 }
 
+// Token-batched F16 projection: [n_tok, K] activation -> [n_tok, N] logits, one pass
+// over the weight. The LM head's batched form; see proj_f16_tok_kernel for the
+// bit-identity argument.
+//
+// RETURNS FALSE MEANING "USE THE PER-TOKEN PATH", NEVER "ERROR" — the same contract
+// every other batched helper in this file keeps. n_tok == 1 declines on its first
+// line, so a caller that always routes through here gets the exact single-token
+// launch k3_proj_f32 makes today.
+bool k3_proj_f16_tok_f32(float* y, int ldy, const float* x, int64_t x_stride,
+                         const void* W, int wtype, int N, int K, int n_tok,
+                         cudaStream_t stream) {
+    if (N <= 0 || K <= 0 || n_tok <= 1) return false;
+    if (wtype != 1 || !W || !y || !x) return false;
+    if (ldy < N) return false;
+    if (x_stride < (int64_t)K) return false;
+
+    // BLOCK follows k3_proj_f32's F16 arm exactly, so the per-thread k-walk that the
+    // bit-identity argument rests on is the same walk. The head is N = 163840, which
+    // takes the `N > 64` branch to 128 either way; the other tiers are kept so a
+    // narrow banded head lands where the single-token path would.
+    const int blk = (N > 64 || K < 1024) ? 128 : (K >= 4096 ? 1024 : 512);
+
+    // TOKS is what divides the weight traffic. 8 is as far as the accumulator array
+    // goes before register pressure costs more occupancy than the extra reuse buys,
+    // and the grid stays wide regardless because N is enormous for the head.
+    static const int env_toks = [] {
+        const char* e = std::getenv("SPARKINFER_K3_HEAD_TOKS");
+        const int v = e ? std::atoi(e) : 8;
+        return (v == 0 || v == 2 || v == 4 || v == 8) ? v : 8;
+    }();
+    if (env_toks == 0) return false;
+    const int TOKS = n_tok < env_toks ? (n_tok >= 4 ? 4 : 2) : env_toks;
+    const int tok_blocks = (n_tok + TOKS - 1) / TOKS;
+
+#define K3_HEADTOK_LAUNCH(BLK, T)                                                    \
+    do {                                                                             \
+        const dim3 grid((unsigned)N, (unsigned)tok_blocks);                          \
+        k3_pdl_launch(grid, (BLK), 0, stream, proj_f16_tok_kernel<(BLK), (T)>,       \
+                      y, ldy, x, x_stride, (const __half*)W, K, n_tok);              \
+    } while (0)
+#define K3_HEADTOK_TOKS(BLK)                                                         \
+    do {                                                                             \
+        switch (TOKS) {                                                              \
+            case 8:  K3_HEADTOK_LAUNCH(BLK, 8); break;                               \
+            case 4:  K3_HEADTOK_LAUNCH(BLK, 4); break;                               \
+            default: K3_HEADTOK_LAUNCH(BLK, 2); break;                               \
+        }                                                                            \
+    } while (0)
+    switch (blk) {
+        case 1024: K3_HEADTOK_TOKS(1024); break;
+        case 512:  K3_HEADTOK_TOKS(512);  break;
+        default:   K3_HEADTOK_TOKS(128);  break;
+    }
+#undef K3_HEADTOK_TOKS
+#undef K3_HEADTOK_LAUNCH
+    return true;
+}
+
 // Quantise n_tok CONTIGUOUS [K] activations in one launch.
 //
 // VERIFIED against both shapes in k3_proj_q8_fast.cu. quantize_q8_0_warp_kernel derives
