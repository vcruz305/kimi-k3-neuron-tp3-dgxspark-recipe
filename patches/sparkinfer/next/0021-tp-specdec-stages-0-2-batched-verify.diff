+    const int tp_size = rank.plan.spec.world_size;
+    const int my_rank = rank.plan.spec.rank;
+    KimiK3Weights& w = rank.weights;
+    KimiK3Forward& fwd = rank.fwd;
+
+    // ASKED, NOT INFERRED, and it must be asked for a KDA layer specifically: the phase
+    // refuses what it will not do, and a refusal is a failed pass rather than a slow
+    // one. Layer 0 is KDA, so it answers for the harder of the two types.
+    if (n_tok > 1) {
+        const int cap = kimi_k3_ffn_batch_cap(fwd);
+        if (n_tok > cap) {
+            set_err(error, "dist_forward_batch: n_tok " + std::to_string(n_tok) +
+                               " exceeds scratch cap " + std::to_string(cap) +
+                               " (raise SPARKINFER_K3_PREFILL_CHUNK)");
+            return false;
+        }
+        for (int layer = 0; layer < cfg.n_layers; ++layer) {
+            if (!kimi_k3_attn_batch_ok(fwd, layer, n_tok)) {
+                set_err(error, "dist_forward_batch: Attn phase refuses n_tok=" +
+                                   std::to_string(n_tok) + " at layer " +
+                                   std::to_string(layer));
+                return false;
+            }
+        }
+    }
+    if (!ensure_batch(rank, n_tok)) {
+        set_err(error, "dist_forward_batch: batch scratch cudaMalloc failed");
+        return false;
+    }
+
+    // n_ckpt is reset per FORWARD CALL, not per token: the residual bank is intra-token
+    // scratch rebuilt across the 93 layers and carries nothing between steps. It is a
+    // function of the LAYER, so one scalar serves the whole batch — the bank POINTER
+    // moves per token, the count does not. Getting that backwards writes every token's
+    // checkpoint at the same row and is invisible until the model is deep enough to
+    // bank twice.
+    rank.state.n_ckpt = 0;
+    fwd.debug = nullptr;
+
+    float* x  = rank.xb;
+    float* xn = rank.xb_next;
+    for (int b = 0; b < n_tok; ++b) {
+        if (!embed_token(w, cfg, token_ids[b], x + (size_t)b * H, rank.stream)) {
+            set_err(error, "embed_token failed at batch row " + std::to_string(b));
+            return false;
+        }
+    }
+
+    // Token b's position is pos_vec[b] and state.position is TOKEN 0's, from which the
+    // phase lengths token b at position + 1 + b. Handing the batched phase one shared
+    // position makes every token write the same KV row and attend over the same prefix
+    // — wrong AND faster, so a timing run cannot see it.
+    k3k::k3_fill_pos_vec(rank.pos_vec, rank.state.d_pos, n_tok, rank.stream);
+
+    int*   const base_d_pos = rank.state.d_pos;
+    float* const base_bank  = rank.state.res_bank;
+    const int    base_pos   = rank.state.position;
+    const size_t bank_elems = (size_t)rank.state.max_ckpt * (size_t)H;
+    rank.state.d_pos = rank.pos_vec;
+    if (rank.bank_b) rank.state.res_bank = rank.bank_b;
+
+    // Restores the borrowed state fields on EVERY exit path, including the error
+    // returns below. state.d_pos and state.res_bank are owned by kimi_k3_alloc_state
+    // and freed through it; leaving either pointing into the batch scratch would free
+    // the wrong allocation at teardown.
+    struct Restore {
+        KimiK3DistRank& r; int* dp; float* bk; int pos;
+        ~Restore() { r.state.d_pos = dp; r.state.res_bank = bk; r.state.position = pos; }
+    } restore{rank, base_d_pos, base_bank, base_pos};
+
+    for (int layer = 0; layer < cfg.n_layers; ++layer) {
+        const bool kda_reduce =
+            tp_size > 1 && cfg.is_kda_layer(layer) && KimiK3Weights::shards_kda(w.policy);
+        const bool mla_reduce =
+            tp_size > 1 && !cfg.is_kda_layer(layer) && KimiK3Weights::shards_mla(w.policy);
+        const bool attn_reduce = kda_reduce || mla_reduce;
+        const bool moe_reduce = tp_size > 1 && layer >= cfg.leading_dense;
+
+        if (!kimi_k3_forward_layer_phase(fwd, layer, K3LayerPhase::Attn, x, xn, n_tok)) {
+            set_err(error, "Attn phase failed at layer " + std::to_string(layer));
+            return false;
+        }
+        if (attn_reduce &&
+            !allreduce_partial_batch(fwd, layer, K3LayerPhase::Attn, coll, rank.stream,
+                                     n_tok, error))
+            return false;
+
+        if (!kimi_k3_forward_layer_phase(fwd, layer, K3LayerPhase::FfnPartial, x, xn,
+                                         n_tok)) {
+            set_err(error, "FfnPartial failed at layer " + std::to_string(layer));
+            return false;
+        }
+        if (moe_reduce &&
+            !allreduce_partial_batch(fwd, layer, K3LayerPhase::FfnPartial, coll,
+                                     rank.stream, n_tok, error))
+            return false;
+
+        if (!kimi_k3_forward_layer_phase(fwd, layer, K3LayerPhase::FfnFinish, x, xn,
+                                         n_tok)) {
+            set_err(error, "FfnFinish failed at layer " + std::to_string(layer));
+            return false;
+        }
+        std::swap(x, xn);
+    }
+
+    if (my_rank == 0) {
+        if (cfg.attn_res_block_size > 0) {
+            if (!w.has_output_res_score || !w.output_res_score.ok()) {
+                set_err(error, "missing output_res_score");
+                return false;
+            }
+            // Per token, because each row reads its OWN bank. attn_res_mix_f32 does
+            // carry a row axis, but its bank stride is the one argument #148 got
+            // swapped with the activation stride; keeping this a loop of the exact
+            // single-token call the non-batched path makes removes that question from
+            // this change entirely. It is 93x cheaper than a layer, so the loop costs
+            // nothing worth the risk.
+            for (int b = 0; b < n_tok; ++b) {
+                k3k::attn_res_mix_f32(xn + (size_t)b * H,
+                                      rank.bank_b ? rank.bank_b + (size_t)b * bank_elems
+                                                  : rank.state.res_bank,
+                                      x + (size_t)b * H,
+                                      (const float*)w.output_res_score.data, H,
+                                      rank.state.n_ckpt, cfg.rms_eps, rank.stream);
+            }
+            std::swap(x, xn);
+        }
+        if (!w.output_norm.ok() || !w.output.ok()) {
+            set_err(error, "missing output_norm/output");
+            return false;
+        }
+        k3k::rms_norm_f32(xn, x, (const float*)w.output_norm.data, H, cfg.rms_eps,
+                          rank.stream, n_tok, H, H);
+
+        // THE HEAD, ONCE FOR THE BATCH. A loop of k3_proj_f32 here would re-stream the
+        // 2.349 GB F16 head per position — ~16 ms of weight traffic per extra token,
+        // which roughly doubles the marginal cost of a speculative position and pushes
+        // the break-even acceptance from 0.093 to ~0.19. The batched kernel declines
+        // (returns false) for anything outside its contract, and the loop below is then
+        // exactly what the single-token path runs.
+        if (!k3k::k3_proj_f16_tok_f32(rank.logits, cfg.vocab, xn, H, w.output.data,
+                                      w.output.type, cfg.vocab, H, n_tok,
+                                      rank.stream)) {
+            for (int b = 0; b < n_tok; ++b)
+                if (!k3k::k3_proj_f32(rank.logits + (size_t)b * cfg.vocab,
+                                      xn + (size_t)b * H, w.output.data, w.output.type,
+                                      cfg.vocab, H, rank.stream)) {
+                    set_err(error, "lm head proj failed at row " + std::to_string(b));
+                    return false;
+                }
+        }
+
+        if (out_logits_host) {
+            if (cudaMemcpyAsync(out_logits_host, rank.logits,
+                                (size_t)n_tok * (size_t)cfg.vocab * sizeof(float),
+                                cudaMemcpyDeviceToHost, rank.stream) != cudaSuccess) {
+                set_err(error, "batched logits D2H async failed");
+                return false;
+            }
+            if (cudaStreamSynchronize(rank.stream) != cudaSuccess) {
+                set_err(error, "stream sync after batched logits D2H failed");
+                return false;
+            }
+        }
+    }
+
+    // The pass consumed all n_tok tokens, so the position advances by the whole batch.
+    // ~Restore puts back base_pos first; this is written after it on purpose — the
+    // destructor runs at return, so the value set here is what the next call sees.
+    restore.pos = base_pos + n_tok;
+    if (rank.state.d_pos != base_d_pos) rank.state.d_pos = base_d_pos;
+    {
+        const int next_pos = base_pos + n_tok;
+        if (cudaMemcpyAsync(base_d_pos, &next_pos, sizeof(int), cudaMemcpyHostToDevice,
+                            rank.stream) != cudaSuccess) {
+            set_err(error, "d_pos H2D async failed (batched)");
+            return false;
+        }
+        if (cudaStreamSynchronize(rank.stream) != cudaSuccess) {
+            set_err(error, "stream sync after d_pos H2D failed (batched)");
+            return false;
+        }
+    }
+    return true;
+}
+
 bool kimi_k3_dist_forward_prompt(KimiK3DistRank& rank,
                                  tp::dist::RankCollective& coll,
                                  const int* ids,
