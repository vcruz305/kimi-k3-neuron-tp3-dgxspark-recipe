+// both at the scratch cap with exactly these per-token strides, so they are contiguous
+// [n_tok, width] blocks. Only the count was ever missing.
+bool allreduce_partial_batch(KimiK3Forward& fwd, int layer, K3LayerPhase phase,
+                             tp::dist::RankCollective& coll, cudaStream_t stream,
+                             int n_tok, std::string* error) {
+    int width = 0;
+    float* buf = kimi_k3_partial_buffer(fwd, layer, phase, &width);
+    if (!buf || width <= 0) {
+        set_err(error, "partial buffer missing for batched allreduce");
+        return false;
+    }
+    const std::size_t count = (std::size_t)width * (std::size_t)n_tok;
+    if (!coll.allreduce_f32(buf, count,
