+// SPARKINFER_K3_DIST_PROFILE=1 → CUDA-event phase times (steady tokens only).
+// SPARKINFER_K3_DIST_PROFILE_SKIP=N (default 8) warm tokens skipped.
+// SPARKINFER_K3_DIST_PROFILE_EVERY=N (default 1) sample every Nth after skip.
+// SPARKINFER_K3_DIST_PROFILE_MAX=N (default 16) max samples then stop printing.
+struct DistProf {
+    bool on = false;
+    int skip = 8;
+    int every = 1;
+    int max_samples = 16;
+    int token_i = 0;
+    int samples = 0;
+    cudaEvent_t a = nullptr;
+    cudaEvent_t b = nullptr;
+    float sum_embed = 0, sum_attn = 0, sum_attn_ar = 0, sum_ffn_p = 0;
+    float sum_moe_ar = 0, sum_ffn_f = 0, sum_head = 0, sum_sync = 0, sum_total = 0;
+    long sum_n_attn_ar = 0, sum_n_moe_ar = 0;
+
+    static DistProf& get() {
+        static DistProf P;
+        static bool init = false;
+        if (!init) {
+            init = true;
+            const char* e = std::getenv("SPARKINFER_K3_DIST_PROFILE");
+            P.on = e && e[0] == '1';
+            if (const char* s = std::getenv("SPARKINFER_K3_DIST_PROFILE_SKIP"))
+                P.skip = std::atoi(s);
+            if (const char* s = std::getenv("SPARKINFER_K3_DIST_PROFILE_EVERY"))
+                P.every = std::max(1, std::atoi(s));
+            if (const char* s = std::getenv("SPARKINFER_K3_DIST_PROFILE_MAX"))
+                P.max_samples = std::max(1, std::atoi(s));
+            if (P.on) {
+                cudaEventCreate(&P.a);
+                cudaEventCreate(&P.b);
+            }
+        }
+        return P;
+    }
+
+    bool active_this_token() {
+        if (!on || samples >= max_samples) return false;
+        if (token_i < skip) return false;
+        return ((token_i - skip) % every) == 0;
+    }
+
+    template <class Fn>
+    bool timed(cudaStream_t stream, float& bucket, Fn&& fn) {
+        if (!a) return fn();
+        if (cudaEventRecord(a, stream) != cudaSuccess) return false;
+        if (!fn()) return false;
+        if (cudaEventRecord(b, stream) != cudaSuccess) return false;
+        if (cudaEventSynchronize(b) != cudaSuccess) return false;
+        float ms = 0.f;
+        if (cudaEventElapsedTime(&ms, a, b) != cudaSuccess) return false;
+        bucket += ms;
+        return true;
+    }
+
+    void print_sample(int rank, int tok, long n_attn_ar, long n_moe_ar, float emb, float attn,
+                      float attn_ar, float ffn_p, float moe_ar, float ffn_f, float head,
+                      float sync) {
+        const float tot = emb + attn + attn_ar + ffn_p + moe_ar + ffn_f + head + sync;
+        auto pct = [&](float x) { return tot > 0 ? 100.f * x / tot : 0.f; };
+        std::fprintf(stderr,
+                     "[k3-dist][PROFILE] rank=%d sample=%d tok_i=%d tok_id=%d total_ms=%.3f | "
+                     "embed=%.3f (%.1f%%) attn=%.3f (%.1f%%) attn_ar=%.3f (%.1f%% n=%ld) "
+                     "ffn_partial=%.3f (%.1f%%) moe_ar=%.3f (%.1f%% n=%ld) "
+                     "ffn_finish=%.3f (%.1f%%) head=%.3f (%.1f%%) sync_d2h=%.3f (%.1f%%)\n",
+                     rank, samples, token_i, tok, tot, emb, pct(emb), attn, pct(attn), attn_ar,
+                     pct(attn_ar), n_attn_ar, ffn_p, pct(ffn_p), moe_ar, pct(moe_ar), n_moe_ar,
+                     ffn_f, pct(ffn_f), head, pct(head), sync, pct(sync));
+        std::fflush(stderr);
+        sum_embed += emb;
+        sum_attn += attn;
+        sum_attn_ar += attn_ar;
+        sum_ffn_p += ffn_p;
+        sum_moe_ar += moe_ar;
+        sum_ffn_f += ffn_f;
+        sum_head += head;
+        sum_sync += sync;
+        sum_total += tot;
+        sum_n_attn_ar += n_attn_ar;
+        sum_n_moe_ar += n_moe_ar;
+        ++samples;
+        if (samples == max_samples || samples % 4 == 0) {
+            const float inv = 1.f / (float)samples;
+            const float t = sum_total * inv;
+            auto p2 = [&](float s) { return t > 0 ? 100.f * (s * inv) / t : 0.f; };
+            std::fprintf(stderr,
+                         "[k3-dist][PROFILE_AVG] rank=%d n=%d total_ms=%.3f | "
+                         "embed=%.3f (%.1f%%) attn=%.3f (%.1f%%) attn_ar=%.3f (%.1f%%) "
+                         "ffn_partial=%.3f (%.1f%%) moe_ar=%.3f (%.1f%%) "
+                         "ffn_finish=%.3f (%.1f%%) head=%.3f (%.1f%%) sync_d2h=%.3f (%.1f%%) | "
+                         "mean_n_attn_ar=%.1f mean_n_moe_ar=%.1f\n",
+                         rank, samples, t, sum_embed * inv, p2(sum_embed), sum_attn * inv,
+                         p2(sum_attn), sum_attn_ar * inv, p2(sum_attn_ar), sum_ffn_p * inv,
+                         p2(sum_ffn_p), sum_moe_ar * inv, p2(sum_moe_ar), sum_ffn_f * inv,
+                         p2(sum_ffn_f), sum_head * inv, p2(sum_head), sum_sync * inv, p2(sum_sync),
+                         (double)sum_n_attn_ar / samples, (double)sum_n_moe_ar / samples);
+            std::fflush(stderr);
+        }
+    }
+};
+
 }  // namespace
 
