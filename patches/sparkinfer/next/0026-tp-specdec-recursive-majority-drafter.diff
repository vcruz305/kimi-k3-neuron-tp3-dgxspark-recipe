From 9b259046953b2585374f4c3034e7e08700000000 Mon Sep 17 00:00:00 2001
From: Victor <victor@local>
Date: Wed, 12 Aug 2026 00:00:00 -0700
Subject: [PATCH] tp: 0026 recursive majority ngram drafting

---
 runtime/examples/kimi_k3_dist_generate.cpp    | 19 ++++-
 runtime/examples/kimi_k3_spec_draft_check.cpp | 27 ++++++-
 .../sparkinfer/models/kimi_k3_ngram_draft.h   | 77 +++++++++++++++++++
 3 files changed, 121 insertions(+), 2 deletions(-)

diff --git a/runtime/examples/kimi_k3_dist_generate.cpp b/runtime/examples/kimi_k3_dist_generate.cpp
index 6cefc88..4fc2fec 100644
--- a/runtime/examples/kimi_k3_dist_generate.cpp
+++ b/runtime/examples/kimi_k3_dist_generate.cpp
@@ -67,6 +67,7 @@ void usage(const char* argv0) {
                  "          [--spec-draft K]     # Stage 4 n-gram speculative decode, batch width K\n"
                  "          [--spec-ngram-max N] [--spec-ngram-min N]   # default 3 / 1\n"
                  "          [--spec-min-occur N] [--spec-require-agree]  # match-confidence gate\n"
+                 "          [--spec-majority NUM/DEN]  # recursive majority continuation\n"
                  "          [--spec-weak-draft N]   # width cap for a low-confidence match\n"
                  "\n"
                  "  KV reset sentinel token id = -2 (broadcast between multi-prompts).\n"
@@ -731,6 +732,16 @@ int main(int argc, char** argv) {
             ngram_cfg.min_occurrences = std::atoi(need("--spec-min-occur"));
         else if (!std::strcmp(argv[i], "--spec-require-agree"))
             ngram_cfg.require_agreement = true;
+        else if (!std::strcmp(argv[i], "--spec-majority")) {
+            const char* v = need("--spec-majority");
+            const char* slash = std::strchr(v, '/');
+            if (!slash) {
+                std::fprintf(stderr, "--spec-majority needs NUM/DEN (for example 2/3)\n");
+                return 2;
+            }
+            ngram_cfg.majority_num = std::atoi(v);
+            ngram_cfg.majority_den = std::atoi(slash + 1);
+        }
         else if (!std::strcmp(argv[i], "--spec-weak-draft"))
             ngram_cfg.weak_max_draft = std::atoi(need("--spec-weak-draft"));
         else if (!std::strcmp(argv[i], "-h") || !std::strcmp(argv[i], "--help")) {
@@ -772,6 +783,11 @@ int main(int argc, char** argv) {
             std::fprintf(stderr, "--spec-min-occur must be >= 1\n");
             return 2;
         }
+        if (ngram_cfg.majority_num < 0 || ngram_cfg.majority_den < 1 ||
+            ngram_cfg.majority_num > ngram_cfg.majority_den) {
+            std::fprintf(stderr, "--spec-majority needs 0 <= NUM <= DEN and DEN >= 1\n");
+            return 2;
+        }
         if (ngram_cfg.weak_max_draft >= spec_draft) {
             // A weak cap at or above the full width is not a cap, and reads as one.
             std::fprintf(stderr, "--spec-weak-draft %d must be < --spec-draft %d\n",
@@ -973,9 +989,10 @@ int main(int argc, char** argv) {
             spec_drafted_at.assign((size_t)spec_draft, 0);
             spec_accepted_at.assign((size_t)spec_draft, 0);
             std::printf("[spec-draft] ON K=%d ngram n=[%d,%d] min_occur=%d agree=%d "
-                        "weak_draft=%d\n",
+                        "majority=%d/%d weak_draft=%d\n",
                         spec_draft, ngram_cfg.n_min, ngram_cfg.n_max,
                         ngram_cfg.min_occurrences, ngram_cfg.require_agreement ? 1 : 0,
+                        ngram_cfg.majority_num, ngram_cfg.majority_den,
                         ngram_cfg.weak_max_draft);
             std::fflush(stdout);
         }
diff --git a/runtime/examples/kimi_k3_spec_draft_check.cpp b/runtime/examples/kimi_k3_spec_draft_check.cpp
index e15b77a..eef1d87 100644
--- a/runtime/examples/kimi_k3_spec_draft_check.cpp
+++ b/runtime/examples/kimi_k3_spec_draft_check.cpp
@@ -89,7 +89,8 @@ void test_drafter() {
     // n_min = 2 was measured on TP3: n_min = 1 cost freeform prose 12.5%.
     {
         K3NgramDraftConfig def;
-        check(def.n_max == 3 && def.n_min == 2, "A0 shipped default is n=[2,3]");
+        check(def.n_max == 3 && def.n_min == 2 && def.majority_num == 0,
+              "A0 shipped default is n=[2,3], majority off");
     }
     // Every case below pins the config it means instead of inheriting the default.
     K3NgramDraftConfig c3;
@@ -165,6 +166,30 @@ void test_drafter() {
     check(mismatch == 0,
           "A11 randomized vs reference: " + std::to_string(mismatch) + " mismatches");
     std::printf("     randomized cross-check: 4000 trials, %d mismatches\n", mismatch);
+
+    {   // The latest old continuation is the variable slot (9), but two of the three
+        // occurrences continue with 5. Span copy predicts 9; recursive 2/3 majority
+        // predicts the stable template token, then re-evaluates the augmented history.
+        K3NgramDraftConfig cm;
+        cm.n_min = cm.n_max = 1;
+        cm.min_occurrences = 2;
+        cm.majority_num = 2;
+        cm.majority_den = 3;
+        const std::vector<int> ctx = {1, 5, 1, 5, 1, 9, 1};
+        const std::vector<int> d = draft_of(ctx, 3, cm);
+        check(d == std::vector<int>({5, 1, 5}),
+              "A12 recursive majority template continuation, got " + vec_str(d));
+    }
+    {   // A split vote is below the confidence bar, so majority mode remains free to
+        // decline instead of paying for a verify batch with no evidence behind it.
+        K3NgramDraftConfig cm;
+        cm.n_min = cm.n_max = 1;
+        cm.min_occurrences = 2;
+        cm.majority_num = 2;
+        cm.majority_den = 3;
+        check(draft_of({1, 5, 1, 6, 1}, 3, cm).empty(),
+              "A13 recursive majority rejects a split vote");
+    }
 }
 
 // ---------------------------------------------------------------------------
diff --git a/runtime/include/sparkinfer/models/kimi_k3_ngram_draft.h b/runtime/include/sparkinfer/models/kimi_k3_ngram_draft.h
index 19de03e..c0a57c5 100644
--- a/runtime/include/sparkinfer/models/kimi_k3_ngram_draft.h
+++ b/runtime/include/sparkinfer/models/kimi_k3_ngram_draft.h
@@ -68,6 +68,18 @@ struct K3NgramDraftConfig {
     // giving up its upside. <= 0 means "no cap": a weak match either drafts at full
     // width (when the confidence bar is off) or is declined (when it is on).
     int weak_max_draft = 0;
+
+    // ---- recursive majority continuation (default OFF) ----
+    //
+    // Copying one old span is brittle when a repeated template has variable slots: one
+    // stale slot rejects the rest of an otherwise predictable block. In majority mode,
+    // each draft position is chosen afresh from the highest-order tail with enough prior
+    // occurrences. The chosen continuation must win at least majority_num/majority_den
+    // of those occurrences. The proposed token is appended to a temporary history before
+    // choosing the next one, so the result remains a coherent left-to-right continuation.
+    // A zero numerator preserves the original span-copy path byte for byte.
+    int majority_num = 0;
+    int majority_den = 1;
 };
 
 // What the scan found, for logging and tests. Never needed to use the draft.
@@ -93,6 +105,71 @@ inline int kimi_k3_ngram_draft(const std::vector<int>& ctx, int max_draft,
     const int n_hi = cfg.n_max < (int)len ? cfg.n_max : (int)len;
     const int n_lo = cfg.n_min < 1 ? 1 : cfg.n_min;
 
+    if (cfg.majority_num > 0 && cfg.majority_den > 0) {
+        std::vector<int> work(ctx);
+        int first_n = 0, first_occ = 0, first_best = 0;
+        for (int di = 0; di < max_draft; ++di) {
+            const long long wlen = (long long)work.size();
+            const int whi = cfg.n_max < (int)wlen ? cfg.n_max : (int)wlen;
+            int picked = 0;
+            bool found = false;
+            int picked_n = 0, picked_occ = 0, picked_best = 0;
+
+            for (int n = whi; n >= n_lo && !found; --n) {
+                const int* pat = work.data() + (wlen - n);
+                // Encounter-order storage makes ties deterministic without hashing the
+                // full vocabulary. The first token to reach the winning count wins.
+                std::vector<int> tokens;
+                std::vector<int> counts;
+                int occurrences = 0;
+                for (long long s = 0; s < wlen - n; ++s) {
+                    if (std::memcmp(work.data() + s, pat,
+                                    (std::size_t)n * sizeof(int)) != 0)
+                        continue;
+                    const int tok = work[(std::size_t)(s + n)];
+                    std::size_t ci = 0;
+                    for (; ci < tokens.size(); ++ci)
+                        if (tokens[ci] == tok) break;
+                    if (ci == tokens.size()) {
+                        tokens.push_back(tok);
+                        counts.push_back(1);
+                    } else {
+                        ++counts[ci];
+                    }
+                    ++occurrences;
+                }
+                if (occurrences < cfg.min_occurrences) continue;
+
+                int best_i = 0;
+                for (int i = 1; i < (int)counts.size(); ++i)
+                    if (counts[(std::size_t)i] > counts[(std::size_t)best_i]) best_i = i;
+                const int best = counts[(std::size_t)best_i];
+                if ((long long)best * cfg.majority_den <
+                    (long long)occurrences * cfg.majority_num)
+                    continue;
+                picked = tokens[(std::size_t)best_i];
+                picked_n = n;
+                picked_occ = occurrences;
+                picked_best = best;
+                found = true;
+            }
+            if (!found) break;
+            if (di == 0) {
+                first_n = picked_n;
+                first_occ = picked_occ;
+                first_best = picked_best;
+            }
+            out->push_back(picked);
+            work.push_back(picked);
+        }
+        if (!out->empty() && info) {
+            info->n = first_n;
+            info->occurrences = first_occ;
+            info->agreed = first_best == first_occ;
+        }
+        return (int)out->size();
+    }
+
     const bool gating = cfg.min_occurrences > 1 || cfg.require_agreement ||
                         cfg.weak_max_draft > 0;
 
